# Postgres. Without it, Nabd runs on an embedded Postgres (PGlite) in .data/.
# On Neon, use the pooled URL here and the direct one below for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs session cookies. Any long random string.
AUTH_SECRET=

# Protects /api/cron/* and lets /api/tick skip its once-a-minute throttle.
CRON_SECRET=

# The public address, used in alert links. Vercel sets one automatically.
NABD_PUBLIC_URL=

# Email alerts through Resend. Without these, email alerts are recorded, not sent.
RESEND_API_KEY=
EMAIL_FROM="Nabd <alerts@example.com>"

# Set to 0 to skip the demo workspace.
NABD_SEED_DEMO=1
