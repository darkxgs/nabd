# Postgres. Without it, Nabd runs on an embedded Postgres (PGlite) in .data/.
# On Neon, use the pooled URL here and the direct one below for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs session cookies. Optional: without it, Nabd makes a random key the
# first time it needs one and keeps it in the database (nabd.app_keys).
AUTH_SECRET=

# Vercel Cron sends this as a bearer token. With it, only Vercel Cron can reset
# the demo, and its calls to /api/tick skip the once-a-minute throttle. Optional:
# without it, the demo reset runs at most once every 20 hours, whoever calls it.
CRON_SECRET=

# The public address, used in alert links. Vercel sets one automatically.
NABD_PUBLIC_URL=

# Email alerts through Resend. Without these, email alerts are recorded, not sent.
RESEND_API_KEY=
EMAIL_FROM="Nabd <alerts@example.com>"

# Set to 0 to skip the demo workspace.
NABD_SEED_DEMO=1
